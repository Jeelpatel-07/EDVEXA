# Application
ENVIRONMENT=development
APP_NAME=EDVEXA API

# Replace this placeholder in your personal .env file.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=edvexa-api
JWT_AUDIENCE=edvexa-web

# Token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=60
EMAIL_VERIFICATION_HOURS=24

# PostgreSQL
# Set real credentials when connecting the database.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql+psycopg://edvexa:replace-me@localhost:5432/edvexa

# Database connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5

# React frontend origins, expressed as a JSON array
CORS_ORIGINS=["http://localhost:5173"]

# Refresh-cookie settings for the future session module
REFRESH_COOKIE_NAME=edvexa_refresh
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Local development uses memory; production requires shared Redis.
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PREFIX=edvexa
# Account email links and SMTP (not sent until the delivery utility is run)
FRONTEND_BASE_URL=http://localhost:5173
AUTH_EMAIL_MAX_ATTEMPTS=5
# Production requires a separate Fernet key; see README for the generation command.
# AUTH_EMAIL_ENCRYPTION_KEY=your-generated-fernet-key
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
# Configure username and password together when the mail server requires login.
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@edvexa.example
SMTP_TIMEOUT_SECONDS=10
