# EDVEXA Backend Environment Configuration
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/edvexa_db
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long-edvexa-auth
JWT_ISSUER=edvexa
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
COOKIE_SECURE=false
EMAIL_MODE=console
